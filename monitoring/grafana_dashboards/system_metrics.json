{
  "title": "FinRAG - System Metrics",
  "panels": [
    {
      "type": "timeseries",
      "title": "Query Latency P50/P95/P99",
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(finrag_query_latency_seconds_bucket[5m]))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, rate(finrag_query_latency_seconds_bucket[5m]))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, rate(finrag_query_latency_seconds_bucket[5m]))", "legendFormat": "P99" }
      ]
    },
    {
      "type": "stat",
      "title": "Active Connections",
      "targets": [{ "expr": "finrag_active_connections" }]
    }
  ]
}
